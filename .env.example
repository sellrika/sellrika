# Sellrika settings
#
# Copy this file to `.env` and change what you need:
#   cp .env.example .env
#
# A line that starts with `#` is switched off. Remove the `#` to use it.
# The app reads this file when it starts, so a change needs a restart.
# Full guide: https://developer.sellrika.com/docs/self-hosting


# ------------------------------------------------------------
# 1. The app
# ------------------------------------------------------------

# The port the app listens on.
PORT=3000

# The public address of the app. Set it in production.
# Without it, links are built from the address of each request, which a visitor controls.
# APP_URL=https://pos.example.com

# A long random text. It encrypts saved secrets, like the keys of payment providers.
# Needed in production. Make one with: openssl rand -hex 32
# Keep it safe and never change it: with a new key the saved secrets can not be read.
APP_KEY=

# Set to 1 ONLY when a reverse proxy is in front of the app.
# The app then believes the proxy's X-Forwarded-For / -Host / -Proto headers.
# Without a proxy, anyone could send these headers and claim any IP or host.
# TRUST_PROXY=1

# The asset server in development (`bun run dev`). Not used in production.
VITE_URL=http://localhost:5173


# ------------------------------------------------------------
# 2. The first admin
# ------------------------------------------------------------
# The first start creates this user and a first shop, when the database is empty.
# This user is the platform admin: only they see the Admin section.

ADMIN_EMAIL=admin@sellrika.local
ADMIN_PASSWORD=password


# ------------------------------------------------------------
# 3. Database: sqlite (default), postgres or mysql
# ------------------------------------------------------------
# The app creates and updates its tables by itself on every start.

DB_CONNECTION=sqlite

# --- SQLite: one file ---
DB_FILE=./data/pos.db

# --- PostgreSQL: the whole address ... ---
# DB_CONNECTION=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/sellrika

# --- MySQL 8 or MariaDB: the whole address ... ---
# Make an empty database first. Use the utf8mb4 character set.
# DB_CONNECTION=mysql
# DATABASE_URL=mysql://user:password@localhost:3306/sellrika

# --- ... or its parts (DATABASE_URL wins when both are set) ---
# The default port is 5432 for postgres and 3306 for mysql.
# The default user is "postgres" for postgres and "root" for mysql.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_DATABASE=pos

# --- MySQL only: sign-in without TLS ---
# MySQL 8 signs a user in over TLS, or with the server's public key.
# 1 = the app may ask the server for that key on a connection without TLS.
# Use it only when the database is on a network you trust.
# DB_ALLOW_PUBLIC_KEY_RETRIEVAL=1

# --- PostgreSQL and MySQL: connections ---
# How many connections the app may open.
# DB_POOL_MAX=10
# Seconds before an unused connection is closed.
# DB_IDLE_TIMEOUT=30
# Seconds to wait for a new connection.
# DB_CONNECT_TIMEOUT=10


# ------------------------------------------------------------
# 4. Pictures: local (default), s3, azure or gcs
# ------------------------------------------------------------
# Where uploaded pictures are kept. Fill in only the lines of the driver you pick.
# The app does not create the bucket or the container: make it first.
# Pictures saved before a switch are still read from UPLOAD_DIR.

STORAGE_DRIVER=local

# --- local: a folder on this machine ---
# UPLOAD_DIR=storage

# --- s3: AWS S3, or an S3-compatible service (Cloudflare R2, MinIO, DigitalOcean Spaces) ---
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# The address of the service. Leave it out for AWS.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- azure: Azure Blob Storage ---
# STORAGE_DRIVER=azure
# AZURE_STORAGE_CONTAINER=
# Give the connection string from the Azure portal ...
# AZURE_STORAGE_CONNECTION_STRING=
# ... or the account name and its key.
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=

# --- gcs: Google Cloud Storage ---
# STORAGE_DRIVER=gcs
# GCS_BUCKET=
# The JSON key file of a service account. Leave it out to use the machine's default credentials.
# GCS_KEY_FILE=/path/to/service-account.json

# Where uploaded extensions are kept. Always on this machine, with every driver.
# EXTENSION_UPLOAD_DIR=storage/extensions


# ------------------------------------------------------------
# 5. Online stores and domains
# ------------------------------------------------------------

# Every shop's online store is at <shop>.<STORE_DOMAIN>.
# In production, point a wildcard DNS record (*.shop.example.com) at the server.
# Default: localhost. In development a store opens at http://<shop>.localhost:3000.
# STORE_DOMAIN=shop.example.com

# The host that shops point their own domain at.
# Set   = the app checks each shop's domain and writes the live ones into Traefik's file.
# Empty = shops' own domains are off.
# DOMAIN_CNAME=stores.example.com

# The API docs on a host of their own. Point its DNS at the server and route it to the app in your proxy.
# Empty = the docs stay on the app's host.
# DEVELOPER_DOMAIN=developer.example.com


# ------------------------------------------------------------
# 6. Traefik (only with DOMAIN_CNAME set)
# ------------------------------------------------------------
# The defaults fit docker-compose.yml. Change them only for your own Traefik.

# The two settings docker-compose.yml itself reads:
# The app's own host.
# APP_HOST=pos.example.com
# Your email, for Let's Encrypt.
# ACME_EMAIL=you@example.com

# The file the app writes the domains into. Traefik's file provider must watch its folder.
# TRAEFIK_FILE=/traefik/sellrika-shops.yaml

# Where Traefik reaches this app. Default: this container's own name and PORT.
# TRAEFIK_APP_URL=http://app:3000

# The name of a Traefik service that already reaches this app.
# Empty = the file brings its own, with TRAEFIK_APP_URL.
# TRAEFIK_SERVICE=

# The names your Traefik was started with.
# TRAEFIK_HTTP_ENTRYPOINT=http
# TRAEFIK_HTTPS_ENTRYPOINT=https
# TRAEFIK_CERT_RESOLVER=letsencrypt

# The name of a certificate resolver that uses the DNS challenge.
# Set   = one wildcard certificate for all free store addresses.
# Empty = one certificate for each store.
# STORE_WILDCARD_RESOLVER=


# ------------------------------------------------------------
# 7. Sign in with Google or Microsoft
# ------------------------------------------------------------
# Needs your own Firebase project. All four values are public ones.
# Find them in the Firebase console: Project settings > Your apps.
# Then switch Google on under Authentication > Sign-in method,
# and add this app's host under Authentication > Settings > Authorized domains.
# Empty FIREBASE_API_KEY = no Google button.

# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=

# Set to 1 to also show "Continue with Microsoft".
# Switch the Microsoft provider on in the same Firebase project first.
# FIREBASE_MICROSOFT=1


# ------------------------------------------------------------
# 8. Other
# ------------------------------------------------------------

# A Google Analytics 4 ID for the sign-in pages. Visitors only: never loaded for a signed-in user.
# A shop sets the ID of its own online store in the app.
# GA_ID=G-XXXXXXXXXX

# Where the automatic exchange rates come from.
# EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/USD

# Where the cities and postal codes are downloaded from.
# GEONAMES_ZIP_URL=https://download.geonames.org/export/zip/
# GEONAMES_DUMP_URL=https://download.geonames.org/export/dump/
