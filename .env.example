PORT=3000
VITE_URL=http://localhost:5173

# sqlite | postgres
DB_CONNECTION=sqlite
DB_FILE=./data/pos.db

# postgres (used when DB_CONNECTION=postgres). DATABASE_URL overrides the parts below.
# DATABASE_URL=postgres://user:pass@host:5432/pos
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_DATABASE=pos
# DB_PASSWORD=
# DB_POOL_MAX=10

# first-boot admin (created only when the users table is empty)
ADMIN_EMAIL=admin@sellrika.local
ADMIN_PASSWORD=password

# where uploaded images are stored: local | s3 | azure | gcs (flydrive). Images saved before a switch keep
# being served from UPLOAD_DIR. Only the chosen driver's settings are needed.
# Every driver keeps a file at the same key: uploads/<shop id>/<folder>/<file>.
STORAGE_DRIVER=local
# UPLOAD_DIR=storage
# S3_BUCKET= S3_REGION=auto S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=
# AZURE_STORAGE_CONNECTION_STRING= AZURE_STORAGE_CONTAINER=   (or AZURE_STORAGE_ACCOUNT= + AZURE_STORAGE_KEY=)
# GCS_BUCKET= GCS_KEY_FILE=/path/to/service-account.json

# encrypts stored payment-gateway secrets — set to any long random string (e.g. `openssl rand -hex 32`)
APP_KEY=


# "Continue with Google" on the staff sign-in page, through the platform's own Firebase project
# (Firebase console > Project settings > Your apps; switch Google on under Authentication > Sign-in method
# and add this app's host under Authentication > Settings > Authorized domains). All four are public values.
# Empty FIREBASE_API_KEY = no Google button. FIREBASE_MICROSOFT=1 adds "Continue with Microsoft"
# (switch the Microsoft provider on in the same Firebase project first).
# FIREBASE_AUTH_DOMAIN may be your own subdomain (auth.sellrika.com) once it is a custom domain of the
# project's Firebase Hosting: Google's pop-up then names it instead of <project>.firebaseapp.com.
# FIREBASE_API_KEY= FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com FIREBASE_PROJECT_ID= FIREBASE_APP_ID=

# public base URL, e.g. https://shop.example.com — set this in production. Without it, links handed to
# a payment gateway (and the sitemap) are built from the request's own Host header, which a client controls.
# APP_URL=

# set to 1 ONLY when a reverse proxy really terminates the connection. It is what makes
# X-Forwarded-For / -Host / -Proto believable; without it anyone could claim any IP or any hostname.
# TRUST_PROXY=0

# Google Analytics 4 id of the main site (front page, pricing, sign-in pages). Visitors only: never loaded for a signed-in user.
# A shop's own store sets its id on /online-store. Empty = off.
# GA_ID=G-XXXXXXXXXX

# every shop's online store is at <slug>.<STORE_DOMAIN> (there is no /store/<slug> page).
# Production: shop.sellrika.com, with a wildcard DNS record *.shop.sellrika.com pointing at the server.
# Default localhost: in dev a store opens at http://<slug>.localhost:3000.
# STORE_DOMAIN=shop.sellrika.com

# the API docs on a host of their own, e.g. developer.sellrika.com:
# Point the host's DNS at the server, and route the host to the app in your proxy
# (the app never writes this host into Traefik).
# Empty = the docs stay at /api/docs. In dev: developer.localhost opens at http://developer.localhost:3000.
# DEVELOPER_DOMAIN=developer.sellrika.com

# custom store domains behind Traefik (see docker-compose.yml):
# the host merchants point their DNS at.
# Set = the app checks each shop's domain and writes the live ones into Traefik's config, which gets the SSL.
# Empty = merchants set up DNS and SSL alone.
# DOMAIN_CNAME=stores.example.com
# the Traefik file the app writes; its folder is one Traefik's file provider watches, mounted into the app
# TRAEFIK_FILE=/traefik/sellrika-shops.yaml
# where Traefik reaches this app. Default: this container's own name and PORT.
# TRAEFIK_APP_URL=http://app:3000
# the names your Traefik was started with. The defaults fit docker-compose.yml.
# TRAEFIK_HTTP_ENTRYPOINT=http
# TRAEFIK_HTTPS_ENTRYPOINT=https
# TRAEFIK_CERT_RESOLVER=letsencrypt
# an existing Traefik service that reaches this app, instead of the one the file brings with TRAEFIK_APP_URL.
# Leave it empty unless your proxy already has one.
# TRAEFIK_SERVICE=
