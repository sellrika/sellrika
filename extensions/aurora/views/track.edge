{{--
  "Track your order": the order code + the email or phone it was placed with.
  The form posts to this page, which prints the order below it.
--}}
@component(theme.layout, { search: true })
  <main class="aurora-page is-narrow">
    <a class="aurora-back" href="{{ url.home }}">← {{ t('store.back_to_shop') }}</a>
    <h1 class="aurora-sheet-title">{{ t('store.track_title') }}</h1>

    <form class="aurora-sheet aurora-form" method="post" action="{{ url.track }}" novalidate>
      <label class="aurora-field">
        <span>{{ t('store.order_code') }}</span>
        <input class="aurora-input is-code" name="code" value="{{ query.code }}" autocapitalize="characters" placeholder="{{ t('store.order_code_example') }}">
      </label>
      <label class="aurora-field">
        <span>{{ t('store.email_or_phone') }}</span>
        <input class="aurora-input" name="contact" value="{{ query.contact }}" autocomplete="email" placeholder="{{ t('store.track_contact_hint') }}">
      </label>
      @if(error)
      <p class="aurora-error" role="alert">{{ error }}</p>
      @end
      <button type="submit" class="aurora-add is-inline">{{ t('store.find_my_order') }}</button>
    </form>

    @if(store.login && !store.customer)
    <p class="aurora-muted aurora-small aurora-gap">
      {{ t('store.have_account') }}
      <button type="button" class="aurora-link-button" data-login-open>{{ t('store.sign_in') }}</button>
      {{ t('store.signin_see_orders') }}
    </p>
    @end

    @if(order)
    <div class="aurora-gap">
      @include('store/partials/order')
    </div>
    @end
  </main>
@end
