{{-- A small line icon (Lucide shapes), drawn in the text colour.
  Use: @!component('ext/aurora/icon', { name: 'bag' })
  Names: bag, user, arrow-left, arrow-right, chevron-left, chevron-right, chevron-down,
  minus, plus, trash, share, megaphone, check-circle, alert, octagon, package, log-out. --}}
<svg class="aurora-icon {{ $props.get('class', '') }}" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
@if(name === 'bag')
<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
@elseif(name === 'user')
<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>
@elseif(name === 'arrow-left')
<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
@elseif(name === 'arrow-right')
<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
@elseif(name === 'chevron-left')
<path d="m15 18-6-6 6-6"/>
@elseif(name === 'chevron-right')
<path d="m9 18 6-6-6-6"/>
@elseif(name === 'chevron-down')
<path d="m6 9 6 6 6-6"/>
@elseif(name === 'minus')
<path d="M5 12h14"/>
@elseif(name === 'plus')
<path d="M5 12h14"/><path d="M12 5v14"/>
@elseif(name === 'trash')
<path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
@elseif(name === 'share')
<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4"/><path d="m15.4 6.5-6.8 4"/>
@elseif(name === 'megaphone')
<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>
@elseif(name === 'check-circle')
<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
@elseif(name === 'alert')
<path d="m21.7 18-8-14a2 2 0 0 0-3.5 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>
@elseif(name === 'octagon')
<path d="M7.9 2h8.2L22 7.9v8.2L16.1 22H7.9L2 16.1V7.9z"/><path d="M12 8v4"/><path d="M12 16h.01"/>
@elseif(name === 'package')
<path d="m7.5 4.3 9 5.2"/><path d="M21 8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7Z"/><path d="M3.3 7 12 12l8.7-5"/><path d="M12 22V12"/>
@elseif(name === 'log-out')
<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>
@end
</svg>
