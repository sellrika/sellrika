{{--
  The inside of an address form on the account page (add and edit).
  Expects `address` (the values to show) and `errors`.
  The label box is Aurora's; the address boxes come from the shared partial.
--}}
<label class="aurora-field">
  <span>{{ t('store.label') }} <span class="aurora-muted">{{ t('store.optional_paren') }}</span></span>
  <input class="aurora-input" name="label" value="{{ address.label || '' }}" placeholder="{{ t('store.label_placeholder') }}">
  @if(errors.label)
  <small class="aurora-error">{{ errors.label }}</small>
  @end
</label>
@include('store/partials/address')
<div><button type="submit" class="aurora-add is-inline">{{ t('store.save_address') }}</button></div>
