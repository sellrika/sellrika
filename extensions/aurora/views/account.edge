{{--
  My account. A guest sees a sign-in prompt.
  A signed-in customer gets three tabs (plain links, ?tab=):
  orders, their details (name + phone) and their delivery addresses.
  Every change is a plain form post; an error re-renders this page with `errors` + `old`.
--}}
@component(theme.layout, { search: false })
  <main class="aurora-page is-narrow">
    <a class="aurora-back" href="{{ url.home }}">← {{ t('store.back_to_shop') }}</a>

    <div class="aurora-account-head">
      <div>
        <h1 class="aurora-sheet-title">{{ t('store.my_account') }}</h1>
        @if(store.customer)
        <p class="aurora-muted aurora-small">{{ t('store.signed_in_as', { email: store.customer.email }) }}</p>
        @end
      </div>
      @if(store.customer)
      <form method="post" action="{{ url.account }}/logout">
        <button type="submit" class="aurora-outline">
          @!component('ext/aurora/icon', { name: 'log-out' })
          {{ t('store.sign_out') }}
        </button>
      </form>
      @end
    </div>

    @if(!store.customer)
    <div class="aurora-sheet aurora-form aurora-center">
      @!component('ext/aurora/icon', { name: 'user', class: 'aurora-icon-lg' })
      <p class="aurora-strong">{{ t('store.signin_to_see_orders') }}</p>
      <p class="aurora-muted aurora-small">{{ t(store.login ? 'store.account_intro' : 'store.no_customer_accounts') }}</p>
      @if(store.login)
      <p><button type="button" class="aurora-add is-inline" data-login-open>{{ t('store.sign_in') }}</button></p>
      @end
    </div>
    @else
    {{-- a box for the shop's extensions (their points, a reward): empty by default --}}
    <div data-account-extra></div>
    @let(current = ['details', 'address'].includes(tab) ? tab : 'orders')
    @let(failed = Object.keys(errors || {}).length > 0)
    <nav class="aurora-tabs">
      <a href="{{ url.account }}" {{{ current === 'orders' ? 'aria-current="page"' : '' }}}>{{ t('store.orders') }}</a>
      <a href="{{ url.account }}?tab=details" {{{ current === 'details' ? 'aria-current="page"' : '' }}}>{{ t('store.your_details') }}</a>
      <a href="{{ url.account }}?tab=address" {{{ current === 'address' ? 'aria-current="page"' : '' }}}>{{ t('store.delivery_address') }}</a>
    </nav>

    @if(current === 'details')
    <form class="aurora-sheet aurora-form" method="post" action="{{ url.account }}" novalidate>
      <input type="hidden" name="tab" value="details">
      <label class="aurora-field">
        <span>{{ t('common.name') }}</span>
        <input class="aurora-input" id="acct-name" name="name" autocomplete="name" value="{{ old.name ?? store.customer.name }}" {{{ errors.name ? 'aria-invalid="true"' : '' }}}>
        @if(errors.name)
        <small class="aurora-error">{{ errors.name }}</small>
        @end
      </label>
      <label class="aurora-field">
        <span>{{ t('store.phone_number') }}</span>
        <input class="aurora-input" id="acct-phone" name="phone" type="tel" autocomplete="tel" value="{{ old.phone ?? store.customer.phone }}" {{{ errors.phone ? 'aria-invalid="true"' : '' }}}>
        @if(errors.phone)
        <small class="aurora-error">{{ errors.phone }}</small>
        @end
      </label>
      <div><button type="submit" class="aurora-add is-inline">{{ t('store.save_details') }}</button></div>
      @if(saved)
      <p role="status">{{ t('common.saved') }}</p>
      @end
    </form>

    @elseif(current === 'address')
    <div class="aurora-sheet aurora-form">
      <p class="aurora-muted aurora-small">{{ t('store.addresses_hint') }}</p>
      @if(!store.customer.addresses.length)
      <p class="aurora-muted aurora-small">{{ t('store.no_saved_address') }}</p>
      @else
      <ul class="aurora-rows" aria-label="{{ t('store.saved_addresses') }}">
        @each(a in store.customer.addresses)
        @let(name = a.label || a.address_1)
        @let(mine = failed && String(old.address_id) === String(a.id))
        <li class="aurora-address-row">
          <div class="aurora-row-main">
            <span class="aurora-strong">{{ name }}</span>
            @if(a.phone)
            <span class="aurora-muted"> · {{ a.phone }}</span>
            @end
            <span class="aurora-muted aurora-small aurora-line-block">{{ [a.address_1, a.address_2, [a.city, a.state, a.postal_code].filter(Boolean).join(' '), a.country].filter(Boolean).join(', ') }}</span>
          </div>
          <form method="post" action="{{ url.account }}/addresses/{{ a.id }}/delete">
            <button type="submit" class="aurora-outline is-icon" aria-label="{{ t('store.remove_x', { name }) }}">
              @!component('ext/aurora/icon', { name: 'trash' })
            </button>
          </form>
          <details class="aurora-address-edit" {{ mine ? 'open' : '' }}>
            <summary class="aurora-outline" aria-label="{{ t('store.edit_x', { name }) }}">{{ t('common.edit') }}</summary>
            <form class="aurora-form" method="post" action="{{ url.account }}/addresses/{{ a.id }}" novalidate>
              <input type="hidden" name="address_id" value="{{ a.id }}">
              @let(address = mine ? old : a)
              @include('ext/aurora/address-form')
            </form>
          </details>
        </li>
        @end
      </ul>
      @end

      <details class="aurora-address-add" {{ failed && !old.address_id ? 'open' : '' }}>
        <summary class="aurora-add is-inline">
          @!component('ext/aurora/icon', { name: 'plus' })
          {{ t('store.add_address') }}
        </summary>
        <form class="aurora-form" method="post" action="{{ url.account }}/addresses" novalidate>
          @let(address = failed && !old.address_id ? old : { country: store.country || '' })
          @include('ext/aurora/address-form')
        </form>
      </details>
    </div>

    @else
    <section class="aurora-sheet aurora-form" aria-label="{{ t('store.your_orders') }}">
      @if(!orders || !orders.data.length)
      <p class="aurora-muted aurora-small">{{ t('store.no_orders_yet') }}</p>
      @else
      <ul class="aurora-rows">
        @each(o in orders.data)
        @let(badges = o.status === 'voided' ? ['voided'] : [...(o.status !== 'completed' ? [o.status] : []), ...(o.fulfillment ? [o.fulfillment] : [])])
        <li>
          <a class="aurora-order-row" href="{{ url.order(o.reference) }}" aria-label="{{ t('store.order_number', { code: o.reference }) }}">
            <span class="aurora-row-main">
              <span class="aurora-strong">{{ o.reference }}</span>
              <span class="aurora-muted"> · {{ date(o.created_at) }}</span>
              <span class="aurora-muted aurora-small aurora-line-block aurora-ellipsis">{{ o.items.map((i) => i.qty + ' × ' + i.name).join(', ') }}</span>
            </span>
            @each(b in (badges.length ? badges : ['completed']))
            <span class="aurora-status is-{{ b }}">{{ orderStatus(b) }}</span>
            @end
            <span class="aurora-order-sum">
              <span class="aurora-line-block">{{ money(o.total, store.currency) }}</span>
              @if(o.payment_status !== 'paid' && o.status !== 'voided')
              <span class="aurora-pay is-{{ o.payment_status }}">
                <span class="aurora-pie" aria-hidden="true" style="background: conic-gradient(currentColor {{ o.total > 0 ? Math.min(100, Math.round(o.paid / o.total * 100)) : 0 }}%, transparent 0)"></span>
                {{ t(o.payment_status === 'partial' ? 'orders.partly_paid' : 'orders.unpaid') }}
              </span>
              @end
            </span>
            @!component('ext/aurora/icon', { name: 'chevron-right', class: 'aurora-faint' })
          </a>
        </li>
        @end
      </ul>
      @if(orders.last_page > 1)
      <nav class="aurora-pager">
        <a class="aurora-chip" {{{ orders.page > 1 ? 'href="' + url.account + '?page=' + (orders.page - 1) + '"' : 'aria-disabled="true"' }}} aria-label="{{ t('store.previous_page') }}">{{ t('store.prev') }}</a>
        <span class="aurora-muted">{{ orders.page }} / {{ orders.last_page }}</span>
        <a class="aurora-chip" {{{ orders.page < orders.last_page ? 'href="' + url.account + '?page=' + (orders.page + 1) + '"' : 'aria-disabled="true"' }}} aria-label="{{ t('store.next_page') }}">{{ t('common.next') }}</a>
      </nav>
      @end
      @end
    </section>
    @end
    @end
  </main>
@end
