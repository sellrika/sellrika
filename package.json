{
	"name": "sellrika",
	"type": "module",
	"private": true,
	"license": "PolyForm-Shield-1.0.0",
	"scripts": {
		"dev": "trap \"kill 0\" EXIT; bun --hot app/server.ts & bunx --bun vite",
		"build": "bunx --bun vite build && bunx --bun vite build --ssr && rm -rf build/extensions && bun extensions/build.ts --out build/extensions",
		"start": "NODE_ENV=production bun app/server.ts",
		"migrate": "bun database/migrate.ts",
		"make:migration": "bun database/make.ts",
		"make:extension": "bun extensions/make.ts",
		"build:extension": "bun extensions/build.ts",
		"build:extensions": "bun extensions/build.ts",
		"test": "bun test ./app ./resources ./extensions",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test:e2e": "bun run build && bunx playwright test",
		"test:e2e:headed": "bun run build && bunx playwright test --headed",
		"compile": "NODE_ENV=production bun build ./app/server.ts --outfile=compiled-server --compile --minify --sourcemap",
		"seed": "bun database/seed.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@huggingface/transformers": "4.3.0",
		"@inertiajs/vue3": "^3.9.1",
		"@playwright/test": "^1.64.1",
		"@scalar/api-reference": "^1.74.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "latest",
		"@types/sortablejs": "^1.15.9",
		"@vitejs/plugin-vue": "^6.0.10",
		"onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.4",
		"vue": "^3.5.44"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "^3.1152.0",
		"@bilions/search-js": "^0.5.5",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/archivo": "^5.3.0",
		"@fontsource/dm-sans": "^5.3.0",
		"@fontsource/geist-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@google-cloud/storage": "^8.4.0",
		"@lucide/vue": "^1.57.0",
		"@vueuse/core": "^14.4.0",
		"@vueuse/integrations": "^14.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"edge.js": "^6.5.1",
		"flydrive": "~2.1.0",
		"flydrive-azure": "^1.0.0",
		"grapesjs": "0.23.5",
		"reflect-metadata": "^0.2.2",
		"reka-ui": "^2.11.0",
		"shadcn-vue": "^2.8.2",
		"sortablejs": "^1.15.7",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"typedi": "^0.10.0",
		"vue-sonner": "^2.0.9",
		"zod": "^4.6.7"
	}
}
