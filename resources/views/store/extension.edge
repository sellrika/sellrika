{{--
  A page an extension brings to the store and draws by itself
  (`ctx.storefront.page({ frame: "full" })`), inside the active theme's layout.
  The theme gives the header, the footer, the colours and the fonts.
  The extension gives everything between them: its own heading, its own
  back link, its own columns. So it is not put in the theme's page panel.
  It is as wide as every theme's own header (72rem).
    body  sanitised HTML
    css   the extension's stylesheet, safe to print inside <style>
--}}
@component(theme.layout, { search: false })
<div class="store-extension" style="box-sizing:border-box;width:100%;max-width:72rem;margin:0 auto;padding:2.5rem 1.5rem 4rem">
  @if(css)
  <style>{{{ css }}}</style>
  @end
  {{{ body }}}
</div>
@end
