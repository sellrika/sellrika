{{--
  The catalog: a big heading with the product count, a row of pills
  (categories, sort, "In stock"), the product grid and the pager.
  Filters and pages are plain links and GET forms,
  so the page works without JavaScript.
--}}
@component(theme.layout, { search: true, q: filters.q })
  <div class="wrap home">
    <div class="home-head">
      <div>
        <h1 class="hero">{{ t('store.everything_in_shop') }}</h1>
        <p class="hero-sub">{{ t('store.products_now', { count: catalog.total }) }}</p>
      </div>
      <div class="filters">
        @if(categories.length)
        <nav class="filters-row" aria-label="{{ t('nav.categories') }}">
          <a class="chip {{ filters.category ? '' : 'is-on' }}" href="{{ url.catalog({ q: filters.q, sort: filters.sort, stock: filters.stock }) }}" {{{ filters.category ? '' : 'aria-current="page"' }}}>{{ t('store.all') }}</a>
          @each(c in categories)
          <a class="chip {{ filters.category == c.id ? 'is-on' : '' }}" href="{{ url.catalog({ q: filters.q, sort: filters.sort, stock: filters.stock, category: c.id }) }}" {{{ filters.category == c.id ? 'aria-current="page"' : '' }}}>
            @if(c.color)
            <span class="dot" style="background: {{ c.color }}"></span>
            @end
            {{ c.name }}
            <span class="chip-count">{{ c.count }}</span>
          </a>
          @end
        </nav>
        @end
        <form class="filters-row" method="get" action="{{ url.home }}" data-autosubmit>
          @if(filters.q)
          <input type="hidden" name="q" value="{{ filters.q }}">
          @end
          @if(filters.category)
          <input type="hidden" name="category" value="{{ filters.category }}">
          @end
          <span class="chip select-box">
            <select name="sort" aria-label="{{ t('store_ui.sort_products') }}">
              @each(o in sorts)
              <option value="{{ o.value }}" {{ o.value === filters.sort ? 'selected' : '' }}>{{ o.label }}</option>
              @end
            </select>
            @!component('themes/boutique/icon', { name: 'chevron-down' })
          </span>
          <label class="chip check-chip">
            <input type="checkbox" name="stock" value="1" {{ filters.stock ? 'checked' : '' }}>
            {{ t('store.in_stock') }}
          </label>
          <noscript><button type="submit" class="chip">OK</button></noscript>
        </form>
      </div>
    </div>

    @if(!catalog.data.length)
    <p class="empty">{{ t('store.nothing_try_another') }}</p>
    @else
    <div class="cards">
      @each(p in catalog.data)
      @include('themes/boutique/card')
      @end
    </div>
    @end

    @if(catalog.last_page > 1)
    <nav class="pager">
      @if(pager.prev)
      <a class="pill pill-white" href="{{ pager.prev }}" aria-label="{{ t('store.previous_page') }}">
      @else
      <a class="pill pill-white" aria-disabled="true" aria-label="{{ t('store.previous_page') }}">
      @end
        @!component('themes/boutique/icon', { name: 'chevron-left' })
        {{ t('store.prev') }}
      </a>
      <span class="pager-count">{{ catalog.page }} / {{ catalog.last_page }}</span>
      @if(pager.next)
      <a class="pill pill-white" href="{{ pager.next }}" aria-label="{{ t('store.next_page') }}">
      @else
      <a class="pill pill-white" aria-disabled="true" aria-label="{{ t('store.next_page') }}">
      @end
        {{ t('common.next') }}
        @!component('themes/boutique/icon', { name: 'chevron-right' })
      </a>
    </nav>
    @end
  </div>
@end
