{{-- A custom page the shop built in /online-store (sanitised HTML + its own CSS). --}}
@component(theme.layout, { search: true })
  <div class="wrap sub">
    <a class="back" href="{{ back ? back.url : url.home }}">
      @!component('themes/boutique/icon', { name: 'arrow-left' })
      {{ back ? back.title : t('store.back_to_shop') }}
    </a>
    <div class="panel">
      <h1 class="title">{{ title }}</h1>
      @if(css)
      <style>{{{ css }}}</style>
      @end
      <div class="store-page rich-html">{{{ body }}}</div>
    </div>
  </div>
@end
