{{--
  "Track your order": the order code + the email or phone it was placed with.
  The form posts to this page, which prints the order below it.
--}}
@component(theme.layout, { search: true })
  <div class="n-wrap n-column n-top">
    <a class="n-back" href="{{ url.home }}">
      @!component('themes/noir/icon', { name: 'arrow-left' })
      {{ t('store.back_to_shop') }}
    </a>
    <h1 class="n-title">{{ t('store.track_title') }}</h1>

    <form class="n-panel n-stack" method="post" action="{{ url.track }}" novalidate>
      <div class="n-track-fields">
        <label class="n-field">
          <span>{{ t('store.order_code') }}</span>
          <input name="code" value="{{ query.code }}" autocapitalize="characters" placeholder="{{ t('store.order_code_example') }}" class="n-upper">
        </label>
        <label class="n-field">
          <span>{{ t('store.email_or_phone') }}</span>
          <input name="contact" value="{{ query.contact }}" autocomplete="email" placeholder="{{ t('store.track_contact_hint') }}">
        </label>
      </div>
      @if(error)
      <p class="n-error n-small" role="alert">{{ error }}</p>
      @end
      <div><button type="submit" class="n-btn">{{ t('store.find_my_order') }}</button></div>
    </form>

    @if(store.login && !store.customer)
    <p class="n-muted n-small n-track-note">
      {{ t('store.have_account') }}
      <button type="button" class="n-link-btn" data-login-open>{{ t('store.sign_in') }}</button>
      {{ t('store.signin_see_orders') }}
    </p>
    @end

    @if(order)
    <div class="n-track-order">
      @include('store/partials/order')
    </div>
    @end
  </div>
@end
