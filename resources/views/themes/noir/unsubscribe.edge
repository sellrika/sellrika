{{--
  The unsubscribe link of a marketing email.
  Opening it only asks; the button posts, so a link scanner can't unsubscribe anyone.
--}}
@component(theme.layout, { search: true })
  <div class="n-wrap n-column n-top">
    <a class="n-back" href="{{ url.home }}">
      @!component('themes/noir/icon', { name: 'arrow-left' })
      {{ t('store.back_to_shop') }}
    </a>
    <div class="n-panel n-stack">
      @if(!email)
      <h1 class="n-title">{{ t('marketing.unsubscribe_broken') }}</h1>
      @elseif(done)
      <h1 class="n-title">{{ t('marketing.unsubscribe_done_title') }}</h1>
      <p class="n-muted" role="status">{{ t('marketing.unsubscribe_done', { email, shop: store.name }) }}</p>
      @else
      <h1 class="n-title">{{ t('marketing.unsubscribe_title', { shop: store.name }) }}</h1>
      <p class="n-muted">{{ t('marketing.unsubscribe_text', { email }) }}</p>
      <form method="post" action="{{ action }}">
        <button type="submit" class="n-btn">{{ t('marketing.unsubscribe_button') }}</button>
      </form>
      @end
    </div>
  </div>
@end
