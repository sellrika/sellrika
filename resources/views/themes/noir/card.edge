{{--
  One product in the edge-to-edge grid (catalog and related products). Expects `p`.
  A real link, so crawlers and cmd-click reach the product page.
  script.js opens the product sheet on a plain click ([data-product]).
  The mono "spec" line: the product's category, else how many options it has.
--}}
<a class="n-card {{ p.sold_out ? 'is-sold-out' : '' }}" href="{{ url.product(p) }}" aria-label="{{ p.name }}" data-product="{{ p.id }}">
  <div class="n-frame n-hatch">
    @if(p.images[0])
    <img class="n-card-img" src="{{ p.images[0] }}" alt="{{ p.name }}" loading="lazy">
    @else
    <span class="n-letter" aria-hidden="true">{{ p.name.trim().charAt(0).toUpperCase() }}</span>
    @end
    @if(p.sold_out)
    <span class="n-tag">{{ t('store.sold_out') }}</span>
    @elseif(p.stock !== null && p.stock <= 5)
    <span class="n-tag n-tag--low">{{ t('store.stock_left', { count: p.stock }) }}</span>
    @else
    <span class="n-tag">{{ t('store.in_stock') }}</span>
    @end
  </div>
  <div class="n-card-row">
    <span class="n-card-name">{{ p.name }}</span>
    <span class="n-card-price">
      @if(p.variants.length > 1)
      <span class="n-faint">{{ t('store.from') }}</span>
      @end
      {{ price(p.price) }}
      @if(discountPct(p))
      <s class="n-was">{{ price(p.original_price) }}</s>
      @end
    </span>
  </div>
  <p class="n-spec">{{ ((categories || []).find((c) => p.category_ids.includes(c.id)) || {}).name || (p.variants.length > 1 ? t('store.options_count', { count: p.variants.length }) : '') }}</p>
</a>
