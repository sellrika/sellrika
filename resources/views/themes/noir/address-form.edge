{{--
  The inside of an address form on the account page (add and edit).
  Expects `address` (the values to show) and `errors`.
  The label box is ours; the address boxes come from the shared partial.
--}}
<label class="n-field n-field--plain">
  <span>{{ t('store.label') }} <span class="n-faint">{{ t('store.optional_paren') }}</span></span>
  <input name="label" value="{{ address.label || '' }}" placeholder="{{ t('store.label_placeholder') }}">
  @if(errors.label)
  <small class="n-error">{{ errors.label }}</small>
  @end
</label>
@include('store/partials/address')
<div><button type="submit" class="n-btn">{{ t('store.save_address') }}</button></div>
