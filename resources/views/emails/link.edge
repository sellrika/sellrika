{{-- An email with one link button: the invitation to a new shop owner (app/emails/Invite.Email.ts) and the
     sign-up confirmation (app/emails/Confirm.Email.ts). The caller passes the texts. Table layout + inline
     styles only, like emails/order.edge: mail clients drop <style> blocks and most modern CSS. --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0;padding:24px 12px;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e6e8eb;border-radius:12px">
        <tr>
          <td style="padding:28px 28px 8px">
            <h1 style="margin:0 0 6px;font-size:20px;line-height:1.3;color:#111827">{{ heading }}</h1>
            <p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280">{{ intro }}</p>
          </td>
        </tr>
        <tr>
          <td style="padding:20px 28px">
            <a href="{{ link }}" style="display:inline-block;padding:10px 18px;border-radius:8px;background:#111827;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none">{{ button }}</a>
          </td>
        </tr>
        <tr>
          <td style="padding:0 28px 28px">
            <p style="margin:0;font-size:13px;line-height:1.6;color:#6b7280">
              {{ expires }}<br>
              <a href="{{ link }}" style="color:#111827;word-break:break-all">{{ link }}</a><br>
              {{ t('mail.no_reply') }}
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
