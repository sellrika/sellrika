{{-- Order emails (app/emails/Order.Email.ts, OrderShipped.Email.ts): confirmation (paid or "to pay by …") and the
     shipped notice — same layout, different words. Table layout + inline styles only:
     mail clients drop <style> blocks, flexbox and most modern CSS. Nothing loads from the network:
     the shop logo and the product pictures travel inside the email (`cid:` links, see Order.Email.ts). --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0;padding:24px 12px;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e6e8eb;border-radius:12px">

        <tr>
          <td style="padding:24px 28px;border-bottom:1px solid #eef0f2">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td>
                  @if(shop.logo)
                    <img src="{{ shop.logo }}" alt="{{ shop.name }}" width="40" height="40" style="display:block;border-radius:8px;border:0;margin-bottom:8px">
                  @end
                  <div style="font-size:16px;font-weight:600;color:#111827">{{ shop.name }}</div>
                </td>
                <td align="right" style="font-size:13px;color:#6b7280;white-space:nowrap">
                  <div style="font-weight:600;color:#111827">{{ number }}</div>
                  <div>{{ date }}</div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:28px 28px 8px">
            <h1 style="margin:0 0 6px;font-size:20px;line-height:1.3;color:#111827">{{ hello }}</h1>
            <p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280">{{ intro }}</p>
          </td>
        </tr>

        <tr>
          <td style="padding:20px 28px 0">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;color:#111827">
              @each(item in items)
                <tr>
                  @if(item.image)
                    <td width="64" valign="top" style="width:64px;padding:12px 0;border-bottom:1px solid #f1f2f4">
                      <img src="{{ item.image }}" alt="" width="52" height="52" style="display:block;width:52px;height:52px;border:1px solid #eef0f2;border-radius:8px">
                    </td>
                  @end
                  <td colspan="{{ item.image ? 1 : 2 }}" style="padding:12px 0;border-bottom:1px solid #f1f2f4">
                    <div style="font-weight:500">{{ item.title }}</div>
                    @if(item.each)
                      <div style="font-size:13px;color:#6b7280">{{ item.each }}</div>
                    @end
                    @if(item.note)
                      <div style="font-size:13px;color:#6b7280;white-space:pre-line">{{ item.note }}</div>
                    @end
                  </td>
                  <td align="right" valign="top" style="padding:12px 0;border-bottom:1px solid #f1f2f4;white-space:nowrap">{{ item.amount }}</td>
                </tr>
              @end
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:8px 28px 0">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px">
              @each(line in totals)
                <tr>
                  <td style="padding:{{ line.strong ? '12px 0 0' : '6px 0 0' }};color:{{ line.strong ? '#111827' : '#6b7280' }};font-weight:{{ line.strong ? '600' : '400' }};font-size:{{ line.strong ? '16px' : '14px' }}">{{ line.label }}</td>
                  <td align="right" style="padding:{{ line.strong ? '12px 0 0' : '6px 0 0' }};color:#111827;font-weight:{{ line.strong ? '600' : '400' }};font-size:{{ line.strong ? '16px' : '14px' }};white-space:nowrap">{{ line.amount }}</td>
                </tr>
              @end
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:20px 28px 0">
            <span style="display:inline-block;padding:4px 10px;border-radius:999px;background:{{ paid ? '#ecfdf3' : '#fffaeb' }};color:{{ paid ? '#067647' : '#b54708' }};font-size:12px;font-weight:600">{{ payment }}</span>
            @if(tracking)
              <span style="display:inline-block;margin-left:6px;padding:4px 10px;border-radius:999px;background:#eff6ff;color:#1d4ed8;font-size:12px;font-weight:600">{{ t('mail.tracking', { tracking }) }}</span>
            @end
          </td>
        </tr>

        @if(instructions)
          <tr>
            <td style="padding:16px 28px 0">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fffaeb;border:1px solid #fedf89;border-radius:8px">
                <tr>
                  <td style="padding:14px 16px;font-size:13px;line-height:1.6;color:#374151;white-space:pre-line">{{ instructions }}</td>
                </tr>
              </table>
            </td>
          </tr>
        @end

        @if(note)
          <tr>
            <td style="padding:20px 28px 0">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f9fafb;border:1px solid #eef0f2;border-radius:8px">
                <tr>
                  <td style="padding:14px 16px;font-size:13px;line-height:1.6;color:#374151;white-space:pre-line">{{ note }}</td>
                </tr>
              </table>
            </td>
          </tr>
        @end

        <tr>
          <td style="padding:24px 28px 28px">
            <p style="margin:0;font-size:13px;line-height:1.6;color:#6b7280">
              @if(track)
                {{ t('mail.track_at') }} <a href="{{ track }}" style="color:#111827;font-weight:500">{{ track }}</a>.<br>
              @end
              @if(support)
                {{ t('mail.support_at') }}
                <a href="mailto:{{ support }}" style="color:#111827;font-weight:500">{{ support }}</a>.<br>
              @end
              {{ t('mail.no_reply') }}<br>
              — {{ shop.name }}
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
