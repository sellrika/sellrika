{{-- Marketing emails (app/emails/AbandonedCart.Email.ts, Campaign.Email.ts): the same frame as the order emails
     (order.edge) — table layout + inline styles only, pictures inside the email by `cid:`.
     The abandoned-cart email fills `items` + `total` + `button`; a campaign fills `html` (the owner's text,
     sanitised on save) and `products`. Both end with the unsubscribe link. --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0;padding:24px 12px;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e6e8eb;border-radius:12px">

        <tr>
          <td style="padding:24px 28px;border-bottom:1px solid #eef0f2">
            @if(shop.logo)
              <img src="{{ shop.logo }}" alt="{{ shop.name }}" width="40" height="40" style="display:block;border-radius:8px;border:0;margin-bottom:8px">
            @end
            <div style="font-size:16px;font-weight:600;color:#111827">{{ shop.name }}</div>
          </td>
        </tr>

        @if(heading)
          <tr>
            <td style="padding:28px 28px 8px">
              <h1 style="margin:0 0 6px;font-size:20px;line-height:1.3;color:#111827">{{ heading }}</h1>
              @if(intro)
                <p style="margin:0;font-size:14px;line-height:1.5;color:#6b7280">{{ intro }}</p>
              @end
            </td>
          </tr>
        @end

        @if(html)
          <tr>
            <td style="padding:24px 28px 0;font-size:14px;line-height:1.6;color:#111827">{{{ html }}}</td>
          </tr>
        @end

        @if(items.length)
          <tr>
            <td style="padding:20px 28px 0">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;color:#111827">
                @each(item in items)
                  <tr>
                    @if(item.image)
                      <td width="64" valign="top" style="width:64px;padding:12px 0;border-bottom:1px solid #f1f2f4">
                        <img src="{{ item.image }}" alt="" width="52" height="52" style="display:block;width:52px;height:52px;border:1px solid #eef0f2;border-radius:8px">
                      </td>
                    @end
                    <td colspan="{{ item.image ? 1 : 2 }}" style="padding:12px 0;border-bottom:1px solid #f1f2f4;font-weight:500">{{ item.title }}</td>
                    <td align="right" valign="top" style="padding:12px 0;border-bottom:1px solid #f1f2f4;white-space:nowrap">{{ item.amount }}</td>
                  </tr>
                @end
                @if(total)
                  <tr>
                    <td colspan="2" style="padding:12px 0 0;font-size:16px;font-weight:600">{{ t('mail.total') }}</td>
                    <td align="right" style="padding:12px 0 0;font-size:16px;font-weight:600;white-space:nowrap">{{ total }}</td>
                  </tr>
                @end
              </table>
            </td>
          </tr>
        @end

        @if(products.length)
          <tr>
            <td style="padding:20px 28px 0">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;color:#111827">
                @each(p in products)
                  <tr>
                    @if(p.image)
                      <td width="96" valign="top" style="width:96px;padding:12px 0;border-bottom:1px solid #f1f2f4">
                        <a href="{{ p.url }}"><img src="{{ p.image }}" alt="{{ p.name }}" width="80" height="80" style="display:block;width:80px;height:80px;border:1px solid #eef0f2;border-radius:8px"></a>
                      </td>
                    @end
                    <td colspan="{{ p.image ? 1 : 2 }}" valign="top" style="padding:12px 0;border-bottom:1px solid #f1f2f4">
                      <div style="font-weight:600">{{ p.name }}</div>
                      <div style="margin:2px 0 6px;color:#6b7280">{{ p.price }}</div>
                      <a href="{{ p.url }}" style="color:#111827;font-weight:500">{{ t('marketing.view_product') }}</a>
                    </td>
                  </tr>
                @end
              </table>
            </td>
          </tr>
        @end

        @if(button)
          <tr>
            <td style="padding:24px 28px 0">
              <a href="{{ button.url }}" style="display:inline-block;padding:12px 20px;border-radius:8px;background:#111827;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none">{{ button.label }}</a>
            </td>
          </tr>
        @end

        <tr>
          <td style="padding:24px 28px 28px">
            <p style="margin:0;font-size:12px;line-height:1.6;color:#6b7280">
              {{ t('marketing.why_you_get_this', { shop: shop.name }) }}
              <a href="{{ unsubscribe }}" style="color:#6b7280">{{ t('marketing.unsubscribe') }}</a>.<br>
              — {{ shop.name }}
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
